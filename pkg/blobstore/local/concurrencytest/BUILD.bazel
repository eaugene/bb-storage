load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "concurrencytest_test",
    srcs = [
        "flat_blob_access_concurrent_test.go",
        "persistent_block_list_concurrent_test.go",
        "refresh_stripe_dedup_test.go",
        "volatile_block_list_concurrent_test.go",
    ],
    # These tests exist to be run under the race detector: they drive
    # concurrent traffic and assert almost nothing themselves, so without
    # -race they would pass even if the internal synchronisation added to
    # PersistentBlockList and hashingKeyLocationMap were reverted.
    race = "on",
    deps = [
        "//pkg/blobstore/buffer",
        "//pkg/blobstore/local",
        "//pkg/capabilities",
        "//pkg/digest",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "benchmark_test",
    srcs = [
        "refresh_contention_bench_test.go",
        "refresh_stress_test.go",
    ],
    # Deliberately NOT race = "on": the race detector perturbs timing by
    # an order of magnitude and these targets measure timing. Their job
    # is the performance A/B against the baseline tree; correctness is
    # covered by :concurrencytest_test, which does run under race.
    #
    # TestRefreshStress skips itself unless BB_STRESS is set, so this
    # target stays fast under `bazel test //...`.
    deps = [
        "//pkg/blobstore",
        "//pkg/blobstore/buffer",
        "//pkg/blobstore/local",
        "//pkg/capabilities",
        "//pkg/digest",
        "//pkg/proto/blobstore/local",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
